# ══════════════════════════════════════════════════════════════════
# PropVerse AI — Git Ignore Rules
# ══════════════════════════════════════════════════════════════════

# ── Environment & Secrets (NEVER push secrets or local credentials to Git) ──
.env
.env.*
*.env
*.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env*
frontend/.env*

# Whitelist safe example/template environment files
!.env.example
!frontend/.env.example
!backend/.env.example

# ── Python & Virtual Environments ──
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
*.whl
build/
dist/

# ── Local Databases & SQLite ──
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# ── Node & Frontend Build ──
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.output/
.oxlint/
.npm/

# ── Deployment & Vercel CLI ──
.vercel/

# ── Logs & Debugging ──
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── IDE & Operating System ──
.vscode/
.idea/
.DS_Store
Thumbs.db
