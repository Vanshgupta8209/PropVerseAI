# Vercel Deployment Ignore File
# Excludes unnecessary development & cache files from deployment build container

# Virtual environments & local dependencies
.venv/
venv/
ENV/
env/

# Documentation & tests
docs/
tests/
backend/tests/
.pytest_cache/
.coverage
htmlcov/

# Local database and cache files
*.db
*.sqlite
*.sqlite3
backend/*.db
backend/*.sqlite3

# Python build artifacts and wheels
__pycache__/
*.pyc
*.pyo
*.pyd
*.whl
*.egg-info/
dist/
build/

# Docker and CI
docker-compose.yml
Dockerfile
backend/Dockerfile
frontend/Dockerfile
.github/

# Git internals
.git/
.gitignore
.gitattributes
