# ══════════════════════════════════════════════════════════════════
# PropVerse AI — Frontend Environment Configuration Template
# Copy this file to .env in this folder (frontend/.env) and populate with your credentials.
# ══════════════════════════════════════════════════════════════════

# Supabase Credentials (Public client access)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend API Endpoint Base URL (e.g. /api/v1 for production reverse proxy, or http://localhost:8000/api/v1 for local dev)
VITE_API_URL=/api/v1
