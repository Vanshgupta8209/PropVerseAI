{
  "version": 2,
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "env": {
    "UV_LINK_MODE": "copy"
  },
  "buildCommand": "unset npm_config_cache_dir NPM_CONFIG_CACHE_DIR 2>/dev/null || true; cd frontend && npm install --prefer-offline --no-audit && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
